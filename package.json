{
  "name": "khelo-vidya",
  "version": "1.0.0",
  "private": true,
  "description": "Gamified, offline-first STEM learning platform in Odia for rural students in grades 6-9",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter server build && pnpm --filter client build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "keywords": [
    "khelo-vidya",
    "sih25048",
    "smart-education",
    "offline-first",
    "pwa",
    "odia",
    "stem"
  ],
  "author": "Binary Beasts",
  "license": "MIT"
}
